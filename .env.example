# Copy to .env for local overrides. Both have working localhost defaults in
# nuxt.config.ts, so this file is only needed when pointing at a non-local
# backend — or when deploying, where both become mandatory.
#
# In production the server refuses to start if either is missing or still points
# at localhost. See server/plugins/validate-runtime-config.ts.
#
# Both are read at BUILD time as well as run time, because the client bundle
# embeds them. Set them before `npm run build`, not only before starting.

# Backend REST API base, including the /api/v1 prefix.
# Production example: https://fangoo-api.up.railway.app/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Absolute public origin of THIS app. Drives canonical tags, og:url,
# sitemap.xml and robots.txt, so it must be the origin visitors actually use.
# Production example: https://fangoo-web.up.railway.app
NUXT_PUBLIC_SITE_URL=http://localhost:3000
