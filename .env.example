# Copy to .env for local overrides. Both have working defaults in nuxt.config.ts,
# so this file is only needed when pointing at a non-local backend.

# Backend REST API base, including the /api/v1 prefix.
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Absolute public origin. Drives canonical tags, og:url, sitemap.xml and
# robots.txt — set this to the real domain in every deployed environment.
NUXT_PUBLIC_SITE_URL=https://fangoo.com
